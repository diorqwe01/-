<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Сервис сравнения тарифов</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>Сервис сравнения тарифов</h1>
      <p>Каталог • Фильтрация • Сравнение • Калькулятор стоимости</p>
    </header>

    <!-- Добавление тарифа -->
    <div class="card">
      <h2>Добавить тариф</h2>
      <div class="form-grid">
        <div>
          <label>Название</label>
          <input type="text" id="name" placeholder="Мой онлайн">
        </div>
        <div>
          <label>Оператор</label>
          <input type="text" id="operator" placeholder="Т2">
        </div>
        <div>
          <label>Цена (₽/мес)</label>
          <input type="number" id="price" min="0" placeholder="500">
        </div>
        <div>
          <label>Интернет (ГБ)</label>
          <input type="number" id="gb" min="0" placeholder="30">
        </div>
        <div>
          <label>Минуты</label>
          <input type="number" id="minutes" min="0" placeholder="400">
        </div>
        <div>
          <label>SMS</label>
          <input type="number" id="sms" min="0" placeholder="100">
        </div>
      </div>
      <button class="btn btn-primary" onclick="addTariff()">Добавить тариф</button>
    </div>

    <!-- Фильтры -->
    <div class="card">
      <h2>Фильтры</h2>
      <div class="filters">
        <div>
          <label>Макс. цена (₽)</label>
          <input type="number" id="filterPrice" min="0" placeholder="Без ограничений">
        </div>
        <div>
          <label>Мин. ГБ</label>
          <input type="number" id="filterGb" min="0" placeholder="0">
        </div>
        <div>
          <label>Мин. минуты</label>
          <input type="number" id="filterMinutes" min="0" placeholder="0">
        </div>
        <div class="filter-buttons">
          <button class="btn btn-primary" onclick="applyFilters()">Применить</button>
          <button class="btn btn-secondary" onclick="resetFilters()">Сбросить</button>
        </div>
      </div>
    </div>

    <!-- Каталог -->
    <div class="card">
      <h2>Каталог тарифов <span id="count"></span></h2>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th class="checkbox-cell">✓</th>
              <th>Название</th>
              <th>Оператор</th>
              <th>Цена</th>
              <th>ГБ</th>
              <th>Минуты</th>
              <th>SMS</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="tariffTable"></tbody>
        </table>
      </div>
      <div class="actions">
        <button class="btn btn-primary" onclick="compareSelected()">Сравнить выбранные</button>
        <button class="btn btn-secondary" onclick="clearSelection()">Снять выбор</button>
      </div>
      <div id="compareResult"></div>
    </div>

    <!-- Калькулятор -->
    <div class="card">
      <h2>Калькулятор стоимости</h2>
      <div class="form-grid">
        <div>
          <label>Выберите тариф</label>
          <select id="calcTariff"></select>
        </div>
        <div>
          <label>Ваш расход интернета (ГБ)</label>
          <input type="number" id="usedGb" min="0" step="0.1" placeholder="25">
        </div>
        <div>
          <label>Цена за 1 ГБ сверх пакета (₽)</label>
          <input type="number" id="overage" min="0" value="30">
        </div>
      </div>
      <button class="btn btn-primary" onclick="calculateCost()">Рассчитать</button>
      <div id="calcResult"></div>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
