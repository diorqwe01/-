<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Вход студента</title>
</head>
<body>

<h1>Личный кабинет студента</h1>

<form id="loginForm">
    <input id="login" placeholder="Логин" required>
    <br><br>

    <input id="password" type="password"
           placeholder="Пароль" required>
    <br><br>

    <button type="submit">Войти</button>
</form>

<h2 id="profile"></h2>

<button id="logout" hidden>Выйти</button>

<p id="message"></p>

<script src="app.js"></script>

</body>
</html>
