<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>JWT авторизация</title>
</head>
<body>

<h1>JWT Authentication</h1>

<form id="loginForm">
    <input id="login" placeholder="Логин" required>
    <br><br>

    <input id="password" type="password"
           placeholder="Пароль" required>
    <br><br>

    <button>Войти</button>
</form>

<br>

<button id="profile">Мой профиль</button>
<button id="refresh">Обновить токен</button>
<button id="logout">Выйти</button>

<p id="result"></p>

<script src="app.js"></script>

</body>
</html>
