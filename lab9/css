body {
    font-family: Arial, sans-serif;
    background: #f0f2f5;
    padding: 20px;
}

.container {
    max-width: 700px;
    margin: 30px auto;
    background: white;
    padding: 20px;
    border-radius: 10px;
}

h1 {
    text-align: center;
}

button {
    padding: 10px;
    background: #007bff;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

li {
    background: #f3f3f3;
    padding: 10px;
    margin: 8px 0;
    overflow-wrap: anywhere;
}
